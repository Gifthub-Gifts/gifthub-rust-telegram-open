# gifthub-rust-telegram — runtime config. Copy to /srv/gifthub-rust-telegram/.env on the host
# (chmod 600). Secrets never live in the repo or CI; only SSH_PRIVATE_KEY exists in GitHub.

# --- Required ------------------------------------------------------------------------------

# MUST be the same Redis + DB Django's apps/telegram/gateway.py pushes to (db 6).
REDIS_URL=redis://127.0.0.1:6379/6

# Bot token from @BotFather (teloxide's conventional var name).
TELOXIDE_TOKEN=

# Ops chats every alert fans out to — one or more numeric chat ids, comma/space-separated.
# Each admin must message the bot once first (bots can't initiate); find ids via:
# curl -s "https://api.telegram.org/bot$TOKEN/getUpdates"
# One failing admin (blocked/never started) never blocks delivery to the others.
TELEGRAM_ADMIN_CHAT_IDS=

# --- Optional (defaults shown) ---------------------------------------------------------------

# Job list + liveness key names (must match the Django settings if changed).
#TELEGRAM_JOBS_KEY=telegram_jobs
#TELEGRAM_HEARTBEAT_KEY=telegram_heartbeat

# Jobs older than this are dropped on arrival — an outage backlog is history, not news.
#STALE_AFTER_SECS=21600

# Collapse window per dedupe_key: first alert sends, repeats inside the window are counted and
# suppressed; the next send appends "(+N suppressed …)".
#DEDUPE_WINDOW_SECS=3600

# 1 = strictly ordered FIFO delivery (also respects Telegram's ~1 msg/sec/chat budget).
# Raising this sacrifices ordering; the loop supports it either way.
#MAX_CONCURRENCY=1

#POP_TIMEOUT_SECS=5
#REQUEST_TIMEOUT_SECS=30
#SEND_MAX_ATTEMPTS=3

#RUST_LOG=info
